# Server Configuration
PORT=3000

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/laburauto

# DocuSeal Configuration
DOCUSEAL_ENABLED=true
DOCUSEAL_INTERNAL_URL=http://docuseal:3000
DOCUSEAL_PUBLIC_URL=https://docs.askn.us
DOCUSEAL_API_KEY=your_api_key_here
DOCUSEAL_WEBHOOK_SECRET=your_webhook_secret_here
# Optional: Regex to filter templates by name (e.g. /^LABURAUTO_/ or LABURAUTO_*)
DOCUSEAL_TEMPLATE_NAME_REGEX=LABURAUTO_*
DOCUSEAL_TEMPLATE_PUBLISHER_ENROLLMENT_ID=
DOCUSEAL_TEMPLATE_RENTAL_AGREEMENT_ID=

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER=https://auth.example.com/application/o/laburauto/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3000/api/auth/sso/authentik/callback
AUTHENTIK_SCOPES="openid profile email groups"
AUTHENTIK_ADMIN_GROUP=laburauto-admins
AUTHENTIK_REQUIRED_DOMAIN=
AUTH_SSO_STATE_SECRET=replace-with-random-secret
APP_URL=http://localhost:5173

# OpenRouter AI Integration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# Bytescale File Upload Integration
# Get your API key from: https://www.bytescale.com/docs/api-keys
BYTESCALE_API_KEY=public_xxxxxxxxxxxxxxxxxxxxx
