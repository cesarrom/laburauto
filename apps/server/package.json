{
  "name": "@laburauto/server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --bundle --outfile=dist/index.js",
    "start": "node dist/apps/server/src/index.js",
    "test": "node scripts/setup-test-db.js && vitest run --fileParallelism=false tests/integration",
    "test:watch": "vitest tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:setup": "node scripts/setup-test-db.js",
    "test:teardown": "node scripts/teardown-test-db.js",
    "test:unit": "vitest run src",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bytescale/sdk": "^3.53.0",
    "@laburauto/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.8",
    "resend": "^6.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}